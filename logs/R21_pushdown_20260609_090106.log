5: future.apply::future_lapply(seq_along(source_groups), FUN = function(gi) {
       combo_idx <- source_groups[[gi]]
       value_fit <- NULL
       for (i in combo_idx) {
           data_file <- file_combos$save_file[i]
           baseline_name <- names(baselines)[baselines == file_combos$baseline[i]]
           file_base <- gsub("_seasons", "", data_file)
           save_file <- gsub(".parquet", "_trends.parquet", file_base)
           save_file2 <- gsub(".parquet", "_trends_ensemble.parquet", 
               file_base)
           save_file3 <- gsub(".parquet", "_trends_ensemble_minimal.parquet", 
               file_base)
           cat(sprintf("3.4) [%s UTC] Processing combo %d/%d (source group %d/%d) %s\n", 
               format(Sys.time(), "%Y-%m-%d %H:%M:%S", tz = "UTC"), 
               i, nrow(file_combos), gi, length(source_groups), 
               basename(data_file)))
           t_combo_start <- Sys.time()
           if (!file.exists(save_file) | overwrite2) {
               data_ex_trend <- data.table(arrow::read_parquet(data_file))
               data_ex_trend <- data_ex_trend[is.finite(value) & 
                   is.finite(year)][, `:=`(n_value, NULL)]
               fit_keys <- c("admin0_name", "admin1_name", "scenario", 
                   "timeframe", "model", "hazard", "season")
               if (is.null(value_fit)) {
                   if (USE_TREND_KERNEL) {
                     .ensure_kernel()
                     value_fit <- data_ex_trend[, fit_value_kernel(year, 
                       value), by = fit_keys]
                   }
                   else {
                     value_fit <- data_ex_trend[, {
                       pw <- yue_tfpw(year, value)
                       yw <- pw$y
                       ts <- if (!pw$applied && !is.null(pw$ts0)) 
                         pw$ts0
                       else tryCatch(sens.slope(yw), error = function(e) NULL)
                       if (is.null(ts)) {
                         list(slope = NA_real_, ci_low = NA_real_, 
                           ci_high = NA_real_, p_value = NA_real_, 
                           tfpw_applied = FALSE, lag1_ac = pw$r)
                       }
                       else {
                         list(slope = unname(ts$estimates), ci_low = ts$conf.int[1], 
                           ci_high = ts$conf.int[2], p_value = tryCatch(mk.test(yw)$p.value, 
                             error = function(e) NA_real_), tfpw_applied = pw$applied, 
                           lag1_ac = pw$r)
                       }
                     }, by = fit_keys]
                   }
               }
               trend_summary <- data_ex_trend[value_fit, on = fit_keys, 
                   .(slope = i.slope, intercept = median(baseline_value - 
                     i.slope * year), ci_low = i.ci_low, ci_high = i.ci_high, 
                     p_value = i.p_value, tfpw_applied = i.tfpw_applied, 
                     lag1_ac = i.lag1_ac), by = .EACHI]
               trend_summary[, `:=`(baseline_name, baseline_name)]
               data_ex_trend_m <- merge(data_ex_trend, trend_summary, 
                   by = c("admin0_name", "admin1_name", "scenario", 
                     "timeframe", "model", "hazard", "season", "baseline_name"), 
                   all.x = TRUE, sort = FALSE)
               data_ex_trend_stats <- data_ex_trend_m[, .(value_slope = slope[1], 
                   value_start = min(year) * slope[1] + intercept[1], 
                   value_s5 = mean(value[1:5]), anomaly_s5 = mean(anomaly[1:5]), 
                   value_end = max(year) * slope[1] + intercept[1], 
                   value_e5 = mean(tail(value, 5)), anomaly_e5 = mean(tail(anomaly, 
                     5)), value_decade = 10 * slope, value_pval = p_value[1]), 
                   by = .(iso3, admin0_name, admin1_name, scenario, 
                     model, timeframe, hazard, season, baseline_name)][, 
                   `:=`(value_diff, value_e5 - value_s5)][, `:=`(anomaly_diff, 
                   anomaly_e5 - anomaly_s5)]
               data_ex_trend_stats_ens <- melt(data_ex_trend_stats, 
                   id.vals = c("admin0_name", "admin1_name", "scenario", 
                     "model", "timeframe", "variable", "season", 
                     "baseline_name"), variable.name = "stat")
               num_cols <- names(data_ex_trend_stats)[sapply(data_ex_trend_stats, 
                   is.numeric)]
               data_ex_trend_stats[, `:=`((num_cols), lapply(.SD, 
                   round, digits = round3.4)), .SDcols = num_cols]
               if (!is.null(order_by2)) {
                   setorderv(data_ex_trend_stats, order_by2)
               }
               write_parquet_pushdown(data_ex_trend_stats, save_file, 
                   sort_by = c("iso3", "admin0_name", "admin1_name", 
                     "hazard", "scenario", "model", "timeframe", 
                     "season"), verify_stats_on = c("admin0_name", 
                     "hazard", "scenario"))
               filters <- list(scenario = data_ex_trend_stats[, 
