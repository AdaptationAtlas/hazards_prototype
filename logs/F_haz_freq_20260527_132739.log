                   mdebugf(" - Finding globals in '%s' for chunk #%d ... DONE", 
                     args_name, ii)
           }
           args_ii <- NULL
           if (!is.null(globals.maxSize)) {
               globals_ii["...future.globals.maxSize"] <- list(globals.maxSize)
           }
